# =============================================================================
# AI Ticketing System — environment template
# Copy to .env and fill real values. .env is gitignored; never commit secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Postgres (self-hosted Supabase database)
# -----------------------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
# JWT expiry (seconds) applied by GoTrue/PostgREST and the db jwt.sql init.
JWT_EXPIRY=3600

# -----------------------------------------------------------------------------
# Supabase (GoTrue / PostgREST / Realtime / Storage / Kong / Studio)
# JWT_SECRET must be >= 32 chars. ANON_KEY and SERVICE_ROLE_KEY are JWTs
# signed with JWT_SECRET (generate with the Supabase self-hosting tooling).
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_jwt_secret_min_32_chars_long
ANON_KEY=CHANGE_ME_supabase_anon_key
SERVICE_ROLE_KEY=CHANGE_ME_supabase_service_role_key
SUPABASE_URL=http://kong:8000
SUPABASE_PUBLIC_URL=http://localhost:8000
SITE_URL=http://localhost:3000
API_EXTERNAL_URL=http://localhost:8000
STUDIO_PORT=3001
KONG_HTTP_PORT=8000

# Supabase Studio dashboard basic auth
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=CHANGE_ME_studio_password
STUDIO_DEFAULT_ORGANIZATION=AI Ticketing
STUDIO_DEFAULT_PROJECT=AI Ticketing

# Supabase service knobs (non-secret; sane defaults for local dev)
PGRST_DB_SCHEMAS=public,storage,graphql_public
ADDITIONAL_REDIRECT_URLS=
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=true
IMGPROXY_ENABLE_WEBP_DETECTION=true
# Realtime Phoenix secret key base (>=64 chars). Regenerate for non-local use.
REALTIME_SECRET_KEY_BASE=CHANGE_ME_realtime_secret_key_base_min_64_chars_long_rrrrrrrrrrrr

# -----------------------------------------------------------------------------
# Qdrant (vector store)
# -----------------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_base

# -----------------------------------------------------------------------------
# Ollama (LLM + embeddings)
# -----------------------------------------------------------------------------
OLLAMA_URL=http://ollama:11434
OLLAMA_LLM_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# -----------------------------------------------------------------------------
# n8n (orchestration; executions persisted to Postgres, not SQLite)
# -----------------------------------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=CHANGE_ME_n8n_encryption_key
WEBHOOK_URL=http://localhost:5678/
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_n8n_password
GENERIC_TIMEZONE=UTC
# n8n execution database (points at the Supabase Postgres instance)
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=db
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=CHANGE_ME_n8n_db_password

# -----------------------------------------------------------------------------
# Email intake (IMAP) and send (SMTP)
# -----------------------------------------------------------------------------
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=support@example.com
IMAP_PASSWORD=CHANGE_ME_imap_password
IMAP_TLS=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=support@example.com
SMTP_PASSWORD=CHANGE_ME_smtp_password
SMTP_SENDER_NAME=AI Ticketing
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_TLS=true

# -----------------------------------------------------------------------------
# Company identity (used in reply templates and knowledge-base generation)
# -----------------------------------------------------------------------------
COMPANY_NAME=Acme Corp
SUPPORT_EMAIL=support@example.com

# -----------------------------------------------------------------------------
# Approval webhook token signing (WF4 — signed, single-use, expiring tokens)
# -----------------------------------------------------------------------------
APPROVAL_TOKEN_SECRET=CHANGE_ME_approval_token_secret
APPROVAL_TOKEN_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# AI layer constants (see CLAUDE.md §5)
# -----------------------------------------------------------------------------
SIMILARITY_FLOOR=0.45
PROMPT_VERSION=v1
REFUSAL_STRING=I do not have enough information to answer this request.

# -----------------------------------------------------------------------------
# Dashboard (Next.js)
# -----------------------------------------------------------------------------
DASHBOARD_PORT=3000
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=CHANGE_ME_supabase_anon_key
