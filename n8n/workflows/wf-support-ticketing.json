    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Aggregates every retrieved chunk into ONE item so the gate below\n// evaluates once per ticket, not once per chunk.\n\nconst chunks = items.map((item, i) => {\n  const doc = item.json.document || item.json;\n  const meta = doc.metadata || {};\n  return {\n    rank: i + 1,\n    score: Number(item.json.score ?? doc.score ?? meta.score ?? meta._score ?? item.json._score ?? 0),\n    doc_name: meta.doc_name || meta.source || 'unknown',\n    section: meta.section || '',\n    text: (doc.pageContent || '').toString()\n  };\n});\n\nconst topScore = chunks.length ? Math.max(...chunks.map(c => c.score)) : 0;\n\nconst contextBlock = chunks\n  .map(c => `[${c.rank}] ${c.doc_name}${c.section ? ' \\u203a ' + c.section : ''} (score ${c.score.toFixed(3)})\\n${c.text}`)\n  .join('\\n\\n---\\n\\n');\n\n// Pull ticket + customer context forward from earlier nodes.\nconst ticket = $('Create Ticket').first().json;\nconst mail   = $('Normalize').first().json;\n\nreturn [{\n  json: {\n    ticket_id: ticket.id,\n    ticket_number: ticket.ticket_number,\n    customer_name: mail.from_name,\n    customer_email: mail.from_email,\n    subject: mail.subject,\n    body_text: mail.body_text,\n    provider_message_id: mail.provider_message_id,\n    chunk_count: chunks.length,\n    top_score: topScore,\n    cited_sources: chunks.map(c => `${c.doc_name}${c.section ? ' \\u203a ' + c.section : ''}`),\n    context_block: contextBlock || '(no documents retrieved)'\n  }\n}];"
      },
