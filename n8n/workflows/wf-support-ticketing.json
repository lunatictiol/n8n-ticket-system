      "id": "a1000000-0000-4000-8000-00000000000c",
      "name": "Ollama — Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOllama",
      "typeVersion": 1,
      "position": [1400, 560],
      "credentials": {
